# Configuração de Ambiente Local - Advocacia Studio Pro v2.0
# Copie este arquivo para .env e insira sua chave obtida gratuitamente no Google AI Studio:
# https://aistudio.google.com/app/apikey

# Chave de API do Google Gemini (Opcional - caso ausente, o bot opera 100% no Modo Local Gratuito)
GEMINI_API_KEY=

# Token Secreto para Autenticação REST na Nuvem / VPS (Opcional localmente; obrigatório em produção na nuvem)
# Suporta cabeçalho "Authorization: Bearer <token>", "x-api-key: <token>" ou "?token=<token>"
API_SECRET_TOKEN=

# Porta do Servidor Headless HTTP (padrão 3000)
PORT=3000
